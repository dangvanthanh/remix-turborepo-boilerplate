{
	"name": "remix-turborepo-boilerplate",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"format": "turbo format",
		"i18n:extract": "lingui extract --clean",
		"i18n:compile": "lingui compile --typescript",
		"prepare": "husky"
	},
	"devDependencies": {
		"@lingui/cli": "^5.5.1",
		"@repo/biome-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.4",
		"turbo": "^2.5.8"
	},
	"packageManager": "bun@1.3.0",
	"engines": {
		"node": ">=20"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"bun run lint",
			"bun run format"
		]
	}
}